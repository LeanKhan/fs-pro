# Copy to .env.production (gitignored) and fill in.
# docker compose -f compose.prod.yaml --env-file .env.production up -d --build

# The public hostname players use, no scheme or port (e.g. play.example.com).
PUBLIC_HOST=
# Host port nginx listens on; put TLS termination in front of it.
WEB_PORT=80

POSTGRES_USER=fspro
POSTGRES_PASSWORD=
POSTGRES_DB=fspro

# Long random strings, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
REALTIME_SECRET=

# Email (Resend, https://resend.com): sign-up confirmation and password reset.
# Add and verify your sending domain in Resend first (the DNS records it shows),
# then create an API key with "Sending access".
RESEND_API_KEY=
# The sender, on that verified domain: FS Pro <noreply@your-domain>
MAIL_FROM=
# Players must confirm their email before founding a club (stops bot accounts).
# Set to false only while testing without email.
REQUIRE_VERIFIED_EMAIL=true

# Chat: extra words to refuse, comma-separated, on top of the short built-in
# list. Put your real list here (slurs especially); no release is needed.
CHAT_BLOCKLIST=

# Optional tuning.
SIM_SERVICE_CONCURRENCY=8
GAME_TIME_SCALE=1
WORLD_TICK_MINUTES=10

# Optional: single sign-on through Imaginations. Names, faces and other
# generated content come from fs-pro's own `worldgen` service and need no
# configuration - the compose files point the server at it.
IMAGINATION_API_URL=
IMAGINATION_CLIENT_ID=
IMAGINATION_CLIENT_SECRET=
IMAGINATION_WORLD_ID=
# Override only if worldgen runs somewhere other than the bundled compose
# service. Defaults to localhost:3004.
WORLDGEN_SERVICE_URL=

# Proxies in front of the server, counting nginx (rate limits and client IPs
# depend on it): 2 = nginx + one TLS proxy such as Traefik or Cloudflare.
TRUST_PROXY=2
