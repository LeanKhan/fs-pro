# Copy to .env.production (gitignored) and fill in.
# docker compose -f compose.prod.yaml --env-file .env.production up -d --build

# The public hostname players use, no scheme or port (e.g. play.example.com).
PUBLIC_HOST=
# Host port nginx listens on; put TLS termination in front of it.
WEB_PORT=80

POSTGRES_USER=fspro
POSTGRES_PASSWORD=
POSTGRES_DB=fspro

# Long random strings, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
REALTIME_SECRET=

# Optional tuning.
SIM_SERVICE_CONCURRENCY=8
GAME_TIME_SCALE=1
WORLD_TICK_MINUTES=10

# Optional: single sign-on through Imaginations, and player faces.
IMAGINATION_API_URL=
IMAGINATION_CLIENT_ID=
IMAGINATION_CLIENT_SECRET=
IMAGINATION_WORLD_ID=
WORLDGEN_SERVICE_URL=

# Proxies in front of the server, counting nginx (rate limits and client IPs
# depend on it): 2 = nginx + one TLS proxy such as Traefik or Cloudflare.
TRUST_PROXY=2
