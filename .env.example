# Postgres container credentials (compose.yaml) - required for `docker
# compose up`; keep the real values in your local, gitignored .env only.
POSTGRES_USER=fspro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fspro


# PostgreSQL Connection (when USE_POSTGRESQL=true)
DATABASE_URL="postgresql://user:password@localhost:5432/fspro?schema=public"

# Server Configuration
NODE_ENV=dev
PORT=3000
REMOTE_HOST=localhost

# Set to true for development testing
DEV_TEST=false

# Imagination World Service (optional - enables map integration)
IMAGINATION_API_URL=http://localhost:8080
IMAGINATION_WORLD_ID=
IMAGINATION_CLIENT_ID=
IMAGINATION_CLIENT_SECRET=
FSPRO_CLIENT_URL=http://localhost:5173
