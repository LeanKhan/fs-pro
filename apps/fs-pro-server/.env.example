DEV_MONGO_URL=<MONGO_DB_CONNECTION_STRING>
 
PROD_MONGO_URL=<MONGO_DB_CONNECTION_STRING>
 
CURRENT_YEAR=JUN-2020 
 
LOGGING=false 
 
REMOTE_HOST=localhost

NODE_ENV=dev

# Database Configuration
# Set to 'true' to use PostgreSQL, otherwise MongoDB will be used
USE_POSTGRESQL=false

# PostgreSQL Connection (when USE_POSTGRESQL=true)
DATABASE_URL="postgresql://user:password@localhost:5432/fspro?schema=public"

# Server Configuration
PORT=3000

# Set to true for development testing
DEV_TEST=false

# worldgen-service (deterministic names/faces microservice) - see
# services/worldgen/client.ts. Defaults to this same value if unset.
WORLDGEN_SERVICE_URL=http://localhost:3004
