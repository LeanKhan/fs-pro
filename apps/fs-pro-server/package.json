{
  "name": "fs-pro-server",
  "version": "0.1.0",
  "description": "Game Server for FS PRO",
  "license": "ISC",
  "author": "@LeanKhan",
  "main": "server.js",
  "scripts": {
    "tsc": "tsc",
    "dev": "set NODE_ENV=dev && npm run start-dev",
    "dev-test": "set NODE_ENV=dev && set DEV_TEST=true && npm run start-dev",
    "start-dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "prod": "tsc && node ./build/server.js",
    "lint": "eslint src/. --ext .ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "echo \"Error: no test specified\" && exit 1",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "db:test": "ts-node src/scripts/test-connection.ts",
    "db:reset:dev": "set DEV_TEST=true && ts-node src/scripts/reset-dev-sql-db.ts",
    "sim:realism": "set DEV_TEST=true && ts-node src/scripts/simRealismCheck.ts",
    "setup:counter-sequences": "ts-node src/scripts/migration/setup-counter-sequences.ts",
    "setup:sessions-table": "ts-node src/scripts/migration/setup-sessions-table.ts",
    "reset:calendar-model": "ts-node src/scripts/migration/reset-calendar-model.ts"
  },
  "dependencies": {
    "@types/express": "^4.16.1",
    "@types/multer": "^1.3.10",
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.4.1",
    "cors": "^2.8.5",
    "dotenv": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.17.1",
    "express-session": "^1.17.1",
    "fast-csv": "^4.3.6",
    "morgan": "^1.10.1",
    "multer": "^1.4.2",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie": "^0.3.3",
    "@types/cors": "^2.8.5",
    "@types/dotenv": "^6.1.1",
    "@types/express-session": "^1.17.0",
    "@types/morgan": "^1.9.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^4.8.2",
    "@typescript-eslint/parser": "^4.8.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^7.14.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "ts-node-dev": "^1.0.0-pre.39",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=8.10.0"
  }
}
