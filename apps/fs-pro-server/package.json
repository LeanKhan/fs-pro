{
  "name": "fs-pro-server",
  "version": "0.1.0",
  "description": "Game Server for FS PRO",
  "main": "server.js",
  "engines": {
    "node": ">=8.10.0"
  },
  "scripts": {
    "tsc": "tsc",
    "dev": "set NODE_ENV=dev && npm run start-dev",
    "dev-test": "set NODE_ENV=dev && set DEV_TEST=true && npm run start-dev",
    "start-dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "prod": "tsc && node ./build/server.js",
    "lint": "eslint src/. --ext .ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "db:test": "ts-node src/scripts/test-connection.ts",
    "sim:realism": "set DEV_TEST=true && ts-node src/scripts/simRealismCheck.ts",
    "migrate:places": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-places.ts",
    "migrate:awards": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-awards.ts",
    "migrate:users": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-users.ts",
    "migrate:managers": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-managers.ts",
    "migrate:competitions": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-competitions.ts",
    "migrate:clubs": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-clubs.ts",
    "migrate:calendars": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-calendars.ts",
    "migrate:days": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-days.ts",
    "migrate:seasons": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-seasons.ts",
    "migrate:players": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-players.ts",
    "migrate:player-matches": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-player-matches.ts",
    "migrate:club-matches": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-club-matches.ts",
    "migrate:fixtures": "set DEV_TEST=true && ts-node src/scripts/migration/migrate-fixtures.ts"
  },
  "author": "@LeanKhan",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/connect-mongodb-session": "0.0.3",
    "@types/cookie": "^0.3.3",
    "@types/cors": "^2.8.5",
    "@types/dotenv": "^6.1.1",
    "@types/express-session": "^1.17.0",
    "@types/morgan": "^1.9.10",
    "@typescript-eslint/eslint-plugin": "^4.8.2",
    "@typescript-eslint/parser": "^4.8.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^7.14.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.1.4",
    "prettier": "^2.2.0",
    "ts-node-dev": "^1.0.0-pre.39",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.0.1",
    "@types/express": "^4.16.1",
    "@types/mongoose": "^5.5.3",
    "@types/multer": "^1.3.10",
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "connect-mongodb-session": "^2.3.1",
    "cookie": "^0.4.1",
    "cors": "^2.8.5",
    "dotenv": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^4.17.1",
    "express-session": "^1.17.1",
    "fast-csv": "^4.3.6",
    "mongoose": "^6.3.3",
    "mongoose-autopopulate": "^0.14.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.2",
    "postgres": "^3.4.7",
    "prisma": "^7.0.1",
    "socket.io": "^4.8.3",
    "winston": "^3.7.2"
  }
}
