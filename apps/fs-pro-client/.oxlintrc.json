{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "env": {
    "browser": true
  },
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "off"
  },
  "ignorePatterns": ["**/icons/*.vue", "vite.config.ts"]
}
